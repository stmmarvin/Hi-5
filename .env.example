# Kopieer naar .env en vul eigen waarden in. Zet .env nooit in git.
POSTGRES_PASSWORD=kies-een-lang-wachtwoord
# Minimaal 32 tekens, bijvoorbeeld: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Wachtwoorden van de twee accounts; worden alleen gebruikt als de database nog leeg is.
SEED_BERT_PASSWORD=
SEED_RECEPTIE_PASSWORD=
# true zodra de site via https bereikbaar is (in de cloud altijd true).
COOKIE_SECURE=false
# Poort waarop de database-container op deze computer luistert.
POSTGRES_PORT=5433
# pgAdmin 4 (database bekijken in de browser, http://localhost:5050). Alleen nodig als je pgAdmin start.
PGADMIN_EMAIL=beheer@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050
# Vaste teamlink via ngrok (https://dashboard.ngrok.com/get-started/your-authtoken). Alleen nodig op de computer die de link deelt.
NGROK_AUTHTOKEN=
